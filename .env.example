# ─── Contract Deployment ───
DEPLOYER_PRIVATE_KEY=0xYourDeployerKey
AGENTIC_WALLET_ADDRESS=0xYourAgenticWalletAddress

# ─── Agentic Wallet (server-side swap execution) ───
# This EOA wallet executes all swaps via OKX DEX on behalf of users
# Generate a DEDICATED wallet for this — do NOT use your personal wallet
AGENT_PRIVATE_KEY=0xYourAgenticWalletPrivateKey

# ─── OKX Onchain OS API ───
NEXT_PUBLIC_OKX_PROJECT_ID=your_project_id
OKX_API_KEY=your_api_key
OKX_SECRET_KEY=your_secret_key
OKX_API_PASSPHRASE=your_passphrase

# ─── Frontend ───
NEXT_PUBLIC_DCA_AGENT_ADDRESS=0xYourDeployedVaultAddress
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_id
NEXT_PUBLIC_XLAYER_RPC=https://rpc.xlayer.tech
